{
  "expo": {
    "name": "Thandra",
    "slug": "thandra-cars",
    "scheme": "thandra",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thandracars.selfdrive",
      "infoPlist": {
        "NSContactsUsageDescription": "Thandra asks to read your contacts once before your first booking. They are kept encrypted and used only to trace the car if it is stolen, and you can delete them after your ride."
      }
    },
    "android": {
      "package": "com.thandracars.selfdrive",
      "permissions": [
        "READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-updates",
      [
        "expo-contacts",
        {
          "contactsPermission": "Thandra asks to read your contacts once before your first booking. They are kept encrypted and used only to trace the car if it is stolen, and you can delete them after your ride."
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "59890691-1631-4b14-8a14-50eca52d2c33"
      }
    },
    "owner": "anikethreddy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/59890691-1631-4b14-8a14-50eca52d2c33",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
